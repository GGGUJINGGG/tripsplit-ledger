DATABASE_URL=postgresql+psycopg://tripsplit:tripsplit@localhost:5432/tripsplit
# Only needed to run the backend test suite (`python -m unittest discover -s tests`).
TEST_DATABASE_URL=postgresql+psycopg://tripsplit:tripsplit@localhost:5432/tripsplit_test
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
