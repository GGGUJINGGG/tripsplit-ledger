DATABASE_URL=postgresql+psycopg://tripsplit:tripsplit@localhost:5432/tripsplit
# Only needed to run the backend test suite (`python -m unittest discover -s tests`).
TEST_DATABASE_URL=postgresql+psycopg://tripsplit:tripsplit@localhost:5432/tripsplit_test
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build the link in password-reset emails. In production this
# must be the deployed frontend's URL, not the localhost default —
# otherwise reset links will point at a dev server nobody can reach.
FRONTEND_BASE_URL=http://localhost:5173
# In-memory per-IP rate limiting on /auth/login, /auth/register, and
# /auth/forgot-password. Single-instance only — see app/rate_limit.py.
RATE_LIMIT_ENABLED=true
